# This is a convenience file — each service has its own Dockerfile.
# Use docker-compose.yml to build and run all services.
#
# Build:
#   docker-compose build
#
# Run:
#   docker-compose up
#
# Services:
#   - postgres:5432  (PostgreSQL 16)
#   - neo4j:7474/7687 (Neo4j 5 + GDS)
#   - backend:8000   (FastAPI + spaCy NER)
#   - frontend:3000  (React + Nginx)

echo "Use 'docker-compose up --build' to start all services."
